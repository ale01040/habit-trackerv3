# Copia in .env.local (app) e in .env.test.local (progetto di test). Non committare mai questi file.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=la-chiave-anon-o-publishable

# Supabase → Connect → Session pooler (URI). Serve solo per npm run db:migrate.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Solo in .env.test.local: utenti creati automaticamente dai test di contratto.
VITE_TEST_EMAIL_A=test-a@example.com
VITE_TEST_EMAIL_B=test-b@example.com
VITE_TEST_PASSWORD=una-password-di-test-lunga
